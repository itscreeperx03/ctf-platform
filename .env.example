# SMTP Email Configuration (Optional - for sending real emails via OTP)
# If not provided, the system runs automatically in Developer/Instant Mode
# where the OTP is safely displayed in the console and test helper banner.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="CYBERSTRIKE CTF 2026 <no-reply@cyberctf.local>"
